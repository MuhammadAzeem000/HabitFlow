  "fixed_sql": [
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"icon\" TEXT NULL, \"color\" TEXT NULL, \"frequency\" TEXT NOT NULL, \"target_days\" TEXT NULL, \"weekly_target\" INTEGER NULL, \"reminder_time\" TEXT NULL, \"start_date\" TEXT NOT NULL, \"order_index\" INTEGER NOT NULL DEFAULT 0, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"paused_from\" TEXT NULL, \"paused_until\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habit_completions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_completions\" (\"id\" TEXT NOT NULL, \"habit_id\" TEXT NOT NULL REFERENCES habits (id) ON DELETE CASCADE, \"completion_date\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'done', \"completed_at\" TEXT NOT NULL, \"notes\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"habit_id\", \"completion_date\"));"
        }
      ]
    },
    {
      "name": "habit_schedules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_schedules\" (\"id\" TEXT NOT NULL, \"habit_id\" TEXT NOT NULL REFERENCES habits (id) ON DELETE CASCADE, \"effective_from\" TEXT NOT NULL, \"frequency\" TEXT NOT NULL, \"target_days\" TEXT NULL, \"weekly_target\" INTEGER NULL, PRIMARY KEY (\"id\"), UNIQUE (\"habit_id\", \"effective_from\"));"
        }
      ]
    },
    {
      "name": "challenges",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"challenges\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"habit_id\" TEXT NULL REFERENCES habits (id) ON DELETE SET NULL, \"duration_days\" INTEGER NOT NULL DEFAULT 30, \"start_date\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'active', \"paused_on\" TEXT NULL, \"completed_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "user_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_settings\" (\"id\" TEXT NOT NULL, \"time_format\" TEXT NOT NULL DEFAULT 'system', \"theme\" TEXT NOT NULL DEFAULT 'system', \"notifications_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"notifications_enabled\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "idx_completions_date",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_completions_date ON habit_completions (completion_date)"
        }
      ]
    }
  ]
